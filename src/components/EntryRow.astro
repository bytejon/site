---
import Arrow from './Arrow.astro';
import Tag from './Tag.astro';
import DateMetadata from './DateMetadata.astro';
import { normalizeTags, tagLabel } from '../lib/tags';
import { href } from '../lib/site';
interface Props { url: string; title: string; description?: string; tags?: string[]; date?: Date; updated?: Date; tagLinks?: boolean; draft?: boolean }
const { url, title, description, tags = [], date, updated, tagLinks = false, draft = false } = Astro.props;
const labels = normalizeTags(tags);
---
<div class="section-row entry-row">
  <a class="entry-title-link" href={url}>
  <strong class="entry-title">{title}{draft ? ' (draft)' : ''}<Arrow /></strong>
  {description && <p class="entry-description">{description}</p>}
  </a>
  {labels.length > 0 && <span class="entry-topics" aria-label="Tags">{labels.map(tag => tagLinks ? <a class="entry-tag tag-link" href={href(`articles/?tag=${encodeURIComponent(tag)}`)}>{tagLabel(tag)}</a> : <Tag label={tagLabel(tag)} />)}</span>}
  {(date || updated) && <span class="entry-meta"><DateMetadata date={date} updated={updated} /></span>}
</div>
