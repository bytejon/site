---
import Arrow from './Arrow.astro';
import Tag from './Tag.astro';
import { normalizeTags, tagLabel } from '../lib/tags';
import { formatDate } from '../lib/site';
interface Props { url: string; title: string; description?: string; tags?: string[]; date?: Date; draft?: boolean }
const { url, title, description, tags = [], date, draft = false } = Astro.props;
const labels = normalizeTags(tags).map(tagLabel);
---
<a class="section-row entry-row" href={url}>
  <strong class="entry-title">{title}{draft ? ' (draft)' : ''}</strong>
  {labels.length > 0 && <span class="entry-topics" aria-label="Tags">{labels.map(label => <Tag label={label} />)}</span>}
  {description && <p class="entry-description">{description}</p>}
  {date && <span class="entry-meta"><time datetime={date.toISOString()}>{formatDate(date)}</time></span>}
  <Arrow />
</a>
