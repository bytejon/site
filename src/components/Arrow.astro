---
interface Props { external?: boolean }
import { IconArrowRight, IconArrowUpRight } from '@tabler/icons-astro';
const { external = false } = Astro.props;
const Icon = external ? IconArrowUpRight : IconArrowRight;
---
<Icon class="arrow-icon" size={16} stroke={1.6} aria-hidden="true" focusable="false" />
<style>.arrow-icon { display: inline-block; vertical-align: -.15em; flex-shrink: 0; }</style>
