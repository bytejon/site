---
interface Props { headings: { depth: number; slug: string; text: string }[]; collapseAt?: number }
const collapseAt = Astro.props.collapseAt ?? 1099;
const headings = Astro.props.headings.filter(h => h.depth === 2 || h.depth === 3);
---
{headings.length > 0 && <aside class="reader-outline" data-pagefind-ignore data-collapse-at={collapseAt}><details open><summary>On this page</summary><nav aria-label="On this page"><ul>{headings.map(heading => <li style={`--outline-depth: ${heading.depth - 2}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav></details></aside>}
<style>
  .reader-outline { font-size: 13px; min-width: 0; }
  details { position: sticky; top: calc(var(--sl-nav-height) + 32px); max-height: calc(100vh - var(--sl-nav-height) - 64px); overflow-y: auto; }
  summary { font-weight: 600; color: var(--ink); list-style: none; padding: 6px 12px; min-height: 32px; text-align: right; line-height: 1.4; }
  summary::-webkit-details-marker { display: none; }
  ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 2px; border-right: 1px solid var(--line); }
  li { margin: 0; padding: 0; }
  a { display: block; position: relative; padding: 6px 12px; padding-right: calc(12px + var(--outline-depth) * 12px); min-height: 36px; line-height: 1.5; color: var(--muted); text-align: right; text-decoration: none; overflow-wrap: anywhere; }
  @media (any-hover: hover) and (any-pointer: fine) {
  :global(:root:not([data-touch-input])) a:hover { color: var(--accent); } }
  a[aria-current='location'] { color: var(--accent); }
  a[aria-current='location'] { font-weight: 400; }
  a[aria-current='location']::after { content: ''; position: absolute; top: 2px; bottom: 2px; right: -1px; width: 3px; border-radius: 3px; background: var(--accent); }
  @media(max-width: 1099px) { details { position: static; max-height: none; } summary { cursor: pointer; min-height: 44px; padding-inline: 0; list-style: disclosure-closed; } details[open] > summary { list-style: disclosure-open; } a { min-height: 44px; } .reader-outline { margin-bottom: 24px; } }
</style>
<script>
  for (const outline of document.querySelectorAll<HTMLElement>('.reader-outline')) {
    const details = outline.querySelector('details')!;
    const narrow = matchMedia(`(max-width: ${outline.dataset.collapseAt || 1099}px)`);
    const collapse = () => { details.open = !narrow.matches; };
    collapse(); narrow.addEventListener('change', collapse);
    const links = [...outline.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const headings = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((heading): heading is HTMLElement => !!heading);
    let scheduled = false;
    function update() {
      scheduled = false;
      const offset = document.querySelector('header')?.getBoundingClientRect().bottom || 88;
      const visible = headings.filter(heading => heading.getClientRects().length > 0);
      let current: HTMLElement | undefined = visible[0];
      for (const heading of visible) if (heading.getBoundingClientRect().top <= offset + 48) current = heading;
      if (scrollY > 0 && document.documentElement.scrollHeight - innerHeight - scrollY <= 2) current = visible.at(-1);
      for (const link of links) { if (link.hash === `#${current?.id}`) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); }
    }
    const schedule = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } };
    details.addEventListener('toggle', schedule);
    addEventListener('scroll', schedule, { passive: true }); addEventListener('resize', schedule); addEventListener('hashchange', schedule); addEventListener('load', schedule); update();
  }
</script>
