---
import { getCollection } from 'astro:content';
import ProjectNavList from './ProjectNavList.astro';
import { projectNavigation } from '../lib/project-navigation';
import { href } from '../lib/site';
const current = Astro.locals.starlightRoute.entry.id;
const directory = current.split('/').slice(0, 2).join('/');
const contextual = directory.startsWith('projects/') ? projectNavigation(await getCollection('docs'), current) : [];
---
{contextual.length > 0 && <nav class="project-navigation" aria-label="Documentation"><ProjectNavList entries={contextual} rootHref={href(`${directory}/`)} /></nav>}
