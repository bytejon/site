---
import { IconChevronRight } from '@tabler/icons-astro';
interface Props { returnArticles?: boolean; items: { label: string; href?: string }[] }
const { items, returnArticles = false } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
  <ol>{items.map((item, index) => <li>
    {index > 0 && <IconChevronRight size={14} stroke={1.5} aria-hidden="true" />}
    {index === items.length - 1 ? <span aria-current="page">{item.label}</span> : item.href ? <a href={item.href} data-return-articles={returnArticles && index === 0 || undefined}>{item.label}</a> : <span>{item.label}</span>}
  </li>)}</ol>
</nav>
<style>
  .breadcrumbs { margin-bottom: 16px; color: var(--muted); font-size: 13px; line-height: 1.5; }
  ol { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 0; margin: 0; list-style: none; }
  li { display: flex; align-items: center; gap: 8px; min-width: 0; max-width: 100%; }
  svg { flex: 0 0 auto; }
  a, li > span { display: inline-flex; align-items: center; min-height: 36px; padding-block: 8px; overflow-wrap: anywhere; }
  a { color: var(--muted); text-decoration: none; }
  @media (any-hover: hover) and (any-pointer: fine) {
  :global(:root:not([data-touch-input])) a:hover { color: var(--accent); text-decoration: underline; } }
  [aria-current] { color: var(--ink); }
  @media (max-width: 799px) { a, li > span { min-height: 44px; } }
</style>
