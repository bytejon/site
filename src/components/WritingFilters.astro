---
import { tagLabel } from '../lib/tags';
import { IconAdjustmentsHorizontal } from '@tabler/icons-astro';
interface Props { tags: string[] }
const { tags } = Astro.props;
const groups = [{ name: 'tag', label: 'Tags', options: [{ value: '', label: 'All tags' }, ...tags.map(tag => ({ value: tag, label: tagLabel(tag) }))] }];
---
<form class="writing-filters" aria-label="Filter articles">
  <input type="hidden" name="tag" value="" />
  <div class="filter-toolbar">
    <button class="filter-toggle" type="button" aria-expanded="false" aria-controls="writing-filter-options"><IconAdjustmentsHorizontal size={17} aria-hidden="true" />Filters</button>
    <button class="filter-reset" type="button" disabled>Clear all</button>
    <p class="filter-count" role="status"></p>
  </div>
  <div id="writing-filter-options" class="filter-options" hidden>
    {groups.map(group => <fieldset><legend>{group.label}</legend><div class="filter-choices">{group.options.map(option => <button type="button" class="filter-choice" data-group={group.name} data-value={option.value} aria-pressed={option.value === '' ? 'true' : 'false'}>{option.label}</button>)}</div></fieldset>)}
  </div>
  <div class="active-filters" aria-label="Selected tags" hidden></div>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('.writing-filters')!;
  const trigger = form.querySelector<HTMLButtonElement>('.filter-toggle')!;
  const panel = form.querySelector<HTMLElement>('.filter-options')!;
  const active = form.querySelector<HTMLElement>('.active-filters')!;
  const reset = form.querySelector<HTMLButtonElement>('.filter-reset')!;
  const fields = ['tag'] as const;
  const values = Object.fromEntries(fields.map(name => [name, form.elements.namedItem(name) as HTMLInputElement])) as Record<typeof fields[number], HTMLInputElement>;
  const choices = (name: string) => [...form.querySelectorAll<HTMLButtonElement>(`.filter-choice[data-group="${name}"]`)];
  const selected = { tag: new Set<string>() };
  function setValue(name: typeof fields[number], incoming: string[]) {
    const allowed = choices(name).map(option => option.dataset.value!).filter(Boolean);
    selected[name] = new Set(allowed.filter(value => incoming.includes(value)));
    values[name].value = [...selected[name]].join(',');
    choices(name).forEach(option => option.setAttribute('aria-pressed', String(option.dataset.value ? selected[name].has(option.dataset.value) : selected[name].size === 0)));
  }
  function update() {
    let count = 0;
    document.querySelectorAll<HTMLElement>('.writing-list > li').forEach(row => {
      row.hidden = Boolean(selected.tag.size && !JSON.parse(row.dataset.tags!).some((tag: string) => selected.tag.has(tag)));
      if (!row.hidden) count++;
    });
    const list = document.querySelector<HTMLElement>('.writing-list');
    if (list) list.hidden = count === 0;
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0;
    form.querySelector('.filter-count')!.textContent = `${count} ${count === 1 ? 'entry' : 'entries'}`;
    active.replaceChildren();
    for (const name of fields) {
      for (const value of selected[name]) {
      const label = choices(name).find(option => option.dataset.value === value)!.textContent!;
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'entry-tag filter-chip'; button.dataset.filterRemove = name; button.dataset.value = value;
      button.setAttribute('aria-label', `Remove ${name} filter: ${label}`);
      button.textContent = label;
      const x = document.createElement('span'); x.textContent = '×'; x.setAttribute('aria-hidden', 'true'); button.append(x);
      active.append(button);
      }
    }
    active.hidden = !active.childElementCount;
    reset.disabled = selected.tag.size === 0;
    document.dispatchEvent(new Event('articles:filterschange'));
  }
  function apply() {
    const params = new URLSearchParams(location.search);
    params.delete('type'); params.delete('topic');
    for (const name of fields) {
      params.delete(name);
      for (const value of selected[name]) params.append(name, value);
    }
    const url = `${location.pathname}${params.size ? '?' + params : ''}${location.hash}`;
    if (url !== `${location.pathname}${location.search}${location.hash}`) history.pushState(null, '', url);
    update();
  }
  function restore() {
    const params = new URLSearchParams(location.search);
    setValue('tag', [...params.getAll('tag'), ...params.getAll('type'), ...params.getAll('topic')].map(tag => tag.trim().toLowerCase()));
    update();
  }
  function open(value: boolean) { panel.hidden = !value; trigger.setAttribute('aria-expanded', String(value)); }
  trigger.addEventListener('click', () => open(Boolean(panel.hidden)));
  form.addEventListener('keydown', event => { if (event.key === 'Escape' && !panel.hidden) { open(false); trigger.focus(); event.preventDefault(); } });
  panel.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-choice');
    if (!button) return;
    const name = button.dataset.group as typeof fields[number];
    const value = button.dataset.value!;
    const next = new Set(selected[name]);
    if (!value) next.clear(); else if (next.has(value)) next.delete(value); else next.add(value);
    setValue(name, [...next]); apply();
  });
  active.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!button) return;
    const name = button.dataset.filterRemove as typeof fields[number]; setValue(name, [...selected[name]].filter(value => value !== button.dataset.value));
    apply();
    (active.querySelector<HTMLButtonElement>('button') || trigger).focus();
  });
  reset.addEventListener('click', () => { fields.forEach(name => setValue(name, [])); apply(); trigger.focus(); });
  form.addEventListener('submit', event => event.preventDefault());
  window.addEventListener('popstate', restore);
  restore();
</script>
<style>
  .writing-filters { margin: 24px 0 20px; }
  .filter-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .filter-toggle { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 12px; border: 1px solid transparent; border-radius: 4px; background: transparent; color: var(--muted); font: inherit; font-size: .85rem; cursor: pointer; }
  .filter-toggle:hover, .filter-toggle[aria-expanded='true'] { background: var(--surface); color: var(--ink); border-color: var(--line); }
  .filter-count { margin: 0 0 0 auto; font-size: .82rem; color: var(--muted); }
  .active-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; align-items: center; }
  .active-filters[hidden], .filter-options[hidden] { display: none; }
  .filter-options { margin-top: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 4px; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  fieldset + fieldset { margin-top: 16px; }
  legend { padding: 0; margin-bottom: 8px; color: var(--muted); font-size: .82rem; }
  .filter-choices { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-choice { min-height: 44px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 8px; background: transparent; color: var(--ink); cursor: pointer; font: inherit; font-size: .85rem; overflow-wrap: anywhere; }
  .filter-choice:hover { background: var(--surface); }
  .filter-choice[aria-pressed='true'] { background: #173565; color: #e5efff; border-color: #739de5; }
</style>
