---
import MenuButton from './MenuButton.astro';
import ThemeSelect from './ThemeSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import { useTranslations } from '@astrojs/starlight/internal';
import { href } from '../lib/site';
interface Props { docs?: boolean }
const links = [['Articles', 'articles/'], ['Projects', 'projects/'], ['About', 'about/']];
const current = Astro.url.pathname;
Astro.locals.t ??= useTranslations('en');
---
<nav class="site-nav" aria-label="Site">
  <a class="wordmark" href={href()} aria-label="Jon"><img class="site-logo" src={href('logo.svg')} width="32" height="32" alt="" /></a>
  <div class="nav-links">
    {links.map(([label, path]) => <a href={href(path)} aria-current={current.startsWith(href(path)) ? (current === href(path) ? 'page' : 'location') : undefined}>{label}</a>)}
  </div>
  <div class="nav-controls"><Search /><ThemeSelect /><MenuButton /></div>
</nav>
<div id="site-mobile-menu" class="mobile-nav-panel" popover="auto"><nav aria-label="Site menu">{links.map(([label, path]) => <a href={href(path)} aria-current={current.startsWith(href(path)) ? (current === href(path) ? 'page' : 'location') : undefined}>{label}</a>)}</nav></div>
<script>
  // Real mouse movement re-enables hover on hybrid devices after touch input.
  const pointerMode = (event: PointerEvent) => {
    if (event.pointerType === 'touch') document.documentElement.setAttribute('data-touch-input', '');
    else if (event.pointerType === 'mouse' && (event.type === 'pointerdown' || event.movementX || event.movementY)) document.documentElement.removeAttribute('data-touch-input');
  };
  document.addEventListener('pointerdown', pointerMode, { capture: true, passive: true });
  document.addEventListener('pointermove', pointerMode, { capture: true, passive: true });
  document.querySelectorAll('site-search').forEach(search => {
    search.addEventListener('click', event => {
      if ((event.target as Element).closest('.pagefind-ui__search-clear')) {
        queueMicrotask(() => search.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus());
      }
    });
  });
</script>
