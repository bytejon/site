---
import ChoicePicker from './ChoicePicker.astro';
---
<ChoicePicker label="Color theme" theme value="auto" options={[{value:'auto',label:'Auto'},{value:'dark',label:'Dark'},{value:'light',label:'Light'}]} />
<script>
  type Theme = 'light' | 'dark' | 'auto';
  const preference = (): Theme => {
    const value = localStorage.getItem('starlight-theme');
    return value === 'light' || value === 'dark' ? value : 'auto';
  };
  const systemTheme = matchMedia('(prefers-color-scheme: light)');
  function apply(value: Theme) {
    document.documentElement.dataset.theme = value === 'auto' ? (systemTheme.matches ? 'light' : 'dark') : value;
    document.querySelectorAll<HTMLElement>('[data-theme-picker]').forEach(picker => {
      picker.dataset.value = value;
      picker.dispatchEvent(new CustomEvent('choice:set', { detail: value }));
    });
  }
  document.querySelectorAll<HTMLElement>('[data-theme-picker]').forEach(picker => picker.addEventListener('change', () => {
    const value = picker.dataset.value as Theme;
    localStorage.setItem('starlight-theme', value === 'auto' ? '' : value);
    apply(value);
  }));
  systemTheme.addEventListener('change', () => { if (preference() === 'auto') apply('auto'); });
  window.addEventListener('storage', () => apply(preference()));
  customElements.whenDefined('choice-picker').then(() => apply(preference()));
</script>
