---
import { IconSunMoon } from '@tabler/icons-astro';
---
<label class="theme-picker" title="Color theme">
  <IconSunMoon size={17} stroke={1.6} aria-hidden="true" focusable="false" />
  <span class="theme-label">Theme</span>
  <select aria-label="Color theme" data-theme-picker>
    <option value="auto" selected>Auto</option>
    <option value="dark">Dark</option>
    <option value="light">Light</option>
  </select>
</label>
<script>
  type Theme = 'light' | 'dark' | 'auto';
  const preference = (): Theme => {
    const value = localStorage.getItem('starlight-theme');
    return value === 'light' || value === 'dark' ? value : 'auto';
  };
  const systemTheme = matchMedia('(prefers-color-scheme: light)');
  function apply(value: Theme) {
    document.documentElement.dataset.theme = value === 'auto' ? (systemTheme.matches ? 'light' : 'dark') : value;
    document.querySelectorAll<HTMLSelectElement>('[data-theme-picker]').forEach(picker => { picker.value = value; });
  }
  document.querySelectorAll<HTMLSelectElement>('[data-theme-picker]').forEach(picker => {
    picker.addEventListener('change', () => {
      const value = picker.value as Theme;
      localStorage.setItem('starlight-theme', value === 'auto' ? '' : value);
      apply(value);
    });
  });
  systemTheme.addEventListener('change', () => { if (preference() === 'auto') apply('auto'); });
  window.addEventListener('storage', () => apply(preference()));
  apply(preference());
</script>
<style>
  .theme-picker { position: relative; display: inline-flex; align-items: center; justify-content: center; width: var(--control-size); height: var(--control-size); border-radius: 4px; color: var(--muted); }
  .theme-picker:hover { background: var(--surface); color: var(--ink); }
  .theme-picker:has(select:focus-visible) { outline: 3px solid var(--accent); outline-offset: 3px; }
  select { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; color: var(--ink); background: var(--surface); font: inherit; cursor: pointer; }
  .theme-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
