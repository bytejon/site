---
import { getCollection } from 'astro:content';
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import Breadcrumb from './Breadcrumb.astro';
import { href } from '../lib/site';
const { entry } = Astro.locals.starlightRoute;
const docs = await getCollection('docs');
const parts = entry.id.split('/');
const ancestors = parts.slice(0, -1).map((_, index) => docs.find(doc => doc.id === parts.slice(0, index + 1).join('/'))).filter(doc => doc && !doc.data.draft);
const items: { label: string; href?: string }[] = ancestors.map(doc => ({ label: doc!.data.sidebar.label || doc!.data.title, href: href(`${doc!.id}/`) }));
items.push({ label: entry.data.sidebar.label || entry.data.title, href: undefined });
---
{entry.id.startsWith('projects/') && <Breadcrumb items={items} />}
<DefaultPageTitle />
