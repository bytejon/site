---
import { getCollection } from 'astro:content';
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import ProjectOverview from './ProjectOverview.astro';
import Breadcrumb from './Breadcrumb.astro';
import MenuButton from './MenuButton.astro';
import DocsOutline from './DocsOutline.astro';
import { href } from '../lib/site';
const { entry } = Astro.locals.starlightRoute;
const docs = await getCollection('docs');
const parts = entry.id.split('/');
const ancestors = parts.slice(0, -1).map((_, index) => docs.find(doc => doc.id === parts.slice(0, index + 1).join('/'))).filter(doc => doc && !doc.data.draft);
const items: { label: string; href?: string }[] = ancestors.map(doc => ({ label: doc!.data.sidebar.label || doc!.data.title, href: href(`${doc!.id}/`) }));
items.push({ label: entry.data.sidebar.label || entry.data.title, href: undefined });
---
{entry.id.startsWith('projects/') && <><MenuButton controls="starlight__sidebar" docs label="Documentation" /><Breadcrumb items={items} /></>}
<DefaultPageTitle />
{/^projects\/[^/]+$/.test(entry.id) && <ProjectOverview description={entry.data.description} overview={entry.data.overview} />}
<div class="docs-outline-mobile"><DocsOutline mobile /></div>
<style>
  .docs-outline-mobile { margin-top: 20px; }
  @media (min-width: 72rem) { .docs-outline-mobile { display: none; } }
  @media (max-width: 71.999rem) {
    .docs-outline-mobile :global(details) { position: static; max-height: none; }
    .docs-outline-mobile :global(summary) { cursor: pointer; min-height: 44px; list-style: disclosure-closed; }
    .docs-outline-mobile :global(details[open] > summary) { list-style: disclosure-open; }
    .docs-outline-mobile :global(.reader-outline a) { min-height: 44px; }
  }
</style>
