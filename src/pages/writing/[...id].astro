---
import LegacyRedirect from '../../components/LegacyRedirect.astro';
import { writingPages, href } from '../../lib/site';
export async function getStaticPaths() {
  return (await writingPages()).map(post => ({ params: { id: post.id } }));
}
---
<LegacyRedirect target={href(`articles/${Astro.params.id}/`)} />
