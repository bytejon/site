---
import Arrow from '../components/Arrow.astro';
import { IconPencil, IconBook2, IconCode } from '@tabler/icons-astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { href, posts, formatDate } from '../lib/site';
const latest = (await posts()).slice(0, 3);
---
<SiteLayout title="Jon">
  <section class="hero">
    <h1>Jon</h1>
    <p class="lede">Writing, tutorials, and open-source projects.</p>
  </section>
  <section aria-labelledby="explore"><h2 id="explore">Explore</h2>
    <ul class="section-list">
      <li><a class="section-row" href={href('blog/')}><strong><IconPencil size={20} stroke={1.6} aria-hidden="true" focusable="false" />Blog</strong><p>Posts about interests, work, and ideas.</p><Arrow /></a></li>
      <li><a class="section-row" href={href('tutorials/')}><strong><IconBook2 size={20} stroke={1.6} aria-hidden="true" focusable="false" />Tutorials</strong><p>Guides with room to work through the details.</p><Arrow /></a></li>
      <li><a class="section-row" href={href('projects/')}><strong><IconCode size={20} stroke={1.6} aria-hidden="true" focusable="false" />Projects</strong><p>Open-source code and its documentation.</p><Arrow /></a></li>
    </ul>
  </section>
  <section aria-labelledby="recent"><div class="section-heading"><h2 id="recent">Recent writing</h2><a href={href('blog/')}>All posts <Arrow /></a></div>
    {latest.length ? <ul class="section-list">{latest.map(post => <li><a class="section-row" href={href(`blog/${post.id}/`)}><strong>{post.data.title}</strong><p>{formatDate(post.data.date)} · {post.data.description}</p><Arrow /></a></li>)}</ul> : <p class="empty">No posts published yet.</p>}
  </section>
</SiteLayout>
