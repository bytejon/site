---
import { getEntry, getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import { href } from '../../lib/site';
const entry = await getEntry('docs', 'projects');
const projects = (await getCollection('docs')).filter(entry => /^projects\/[^/]+$/.test(entry.id) && !entry.data.draft);
---
<SiteLayout title="Projects" description={entry!.data.description}>
  <h1 class="page-label">Projects</h1>
  {projects.length > 0 && <ul class="section-list">{projects.map(project => <li><EntryRow url={href(`${project.id}/`)} title={project.data.title} description={project.data.description} tags={project.data.tags} date={project.data.date} /></li>)}</ul>}
</SiteLayout>
