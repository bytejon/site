---
import { getEntry, getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { href } from '../../lib/site';
const entry = await getEntry('docs', 'projects');
const { Content } = await render(entry!);
const projects = (await getCollection('docs')).filter(entry => /^projects\/[^/]+$/.test(entry.id) && !entry.data.draft);
---
<SiteLayout title="Projects" description={entry!.data.description}>
  <h1>Projects</h1>
  <div class="project-intro"><Content /></div>
  {projects.length > 0 && <ul class="section-list">{projects.map(project => <li><a class="section-row" href={href(`${project.id}/`)}><strong>{project.data.title}</strong><p>{project.data.description}</p></a></li>)}</ul>}
</SiteLayout>
