---
import Arrow from '../../../components/Arrow.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { posts, href, formatDate } from '../../../lib/site';
export async function getStaticPaths() {
  const entries = await posts();
  return [...new Set(entries.flatMap(post => post.data.tags))].map(tag => ({ params: { tag }, props: { tag, entries: entries.filter(p => p.data.tags.includes(tag)) } }));
}
const { tag, entries } = Astro.props;
---
<SiteLayout title={`Posts tagged ${tag}`}><p class="eyebrow"><a href={href('blog/')}>Blog</a> / Tags</p><h1>{tag}</h1><ul class="section-list">{entries.map(post => <li><a class="section-row" href={href(`blog/${post.id}/`)}><strong>{post.data.title}</strong><p>{formatDate(post.data.date)} · {post.data.description}</p><Arrow /></a></li>)}</ul></SiteLayout>
