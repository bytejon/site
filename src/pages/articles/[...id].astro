---
import { render } from 'astro:content';
import ReadingPagination from '../../components/ReadingPagination.astro';
import EntryRow from '../../components/EntryRow.astro';
import { relatedEntries } from '../../lib/related';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { tagLabel } from '../../lib/tags';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageOutline from '../../components/PageOutline.astro';
import ProjectNavList from '../../components/ProjectNavList.astro';
import type { ProjectNavEntry } from '../../lib/project-navigation';
import type { Writing } from '../../lib/site';
import { writingPages, rootOf, chapterTree, href, formatDate } from '../../lib/site';
export async function getStaticPaths() {
  const pages = await writingPages();
  return pages.map(post => ({ params: { id: post.id }, props: { post, pages } }));
}
const { post, pages } = Astro.props;
const root = rootOf(post, pages);
const chapters = chapterTree(root, pages);
function pageTree(page: Writing): ProjectNavEntry {
  const link: Extract<ProjectNavEntry,{type:'link'}> = { type: 'link', label: page.data.navTitle || page.data.title, href: href(`articles/${page.id}/`), isCurrent: page.id === post.id, attrs: {} };
  const children = chapters.filter(item => item.page.data.parent === page.id).map(item => pageTree(item.page));
  return children.length ? { type: 'group', label: link.label, page: link, entries: children, collapsed: true } : link;
}
const related = relatedEntries(root, pages, import.meta.env.INCLUDE_DEMOS === 'true');
const updated = post.data.updated || root.data.updated;
const changed = updated && updated > root.data.date!;
const index = chapters.findIndex(item => item.page.id === post.id);
const previous = chapters[index - 1]?.page;
const next = chapters[index + 1]?.page;
const { Content, headings } = await render(post);
const outline = headings.filter(h => h.depth === 2 || h.depth === 3);
const ancestry: Writing[] = [post];
let ancestor: Writing = post;
while (ancestor.data.parent) {
  ancestor = pages.find((page: Writing) => page.id === ancestor.data.parent)!;
  ancestry.unshift(ancestor);
}
const breadcrumb = [{ label: 'Articles', href: href('articles/') }, ...ancestry.map((page, index) => ({ label: index === 0 ? page.data.title : page.data.navTitle || page.data.title, href: page.id !== post.id ? href(`articles/${page.id}/`) : undefined }))];
---
<SiteLayout title={post.data.title} description={post.data.description} wide={chapters.length > 1 || outline.length > 0} draft={post.data.draft}>
  <div class:list={["writing-reader", { "has-chapters": chapters.length > 1, "has-outline": outline.length > 0 }]}>
    {chapters.length > 1 && <aside class="chapter-sidebar" data-pagefind-ignore>
      <button type="button" class="pages-toggle" aria-expanded="false" aria-controls="article-pages" data-pages-toggle>Pages</button>
      <nav id="article-pages" aria-label="Article pages"><ProjectNavList entries={[{ type: 'link', label: root.data.navTitle || root.data.title, href: href(`articles/${root.id}/`), isCurrent: root.id === post.id, attrs: {} }, ...chapters.filter(item => item.page.data.parent === root.id).map(item => pageTree(item.page))]} /></nav>
    </aside>}
    <PageOutline headings={outline} />
    <article class="prose">
      <Breadcrumb items={breadcrumb} returnArticles />
      <h1>{post.data.title}</h1>
      <div class="post-meta"><time datetime={root.data.date!.toISOString()}>{formatDate(root.data.date!)}</time>{changed && <span class="updated-date">Updated <time datetime={updated!.toISOString()}>{formatDate(updated!)}</time></span>}</div>
      {post.data.draft && <aside class="note" data-pagefind-ignore><strong>Unpublished authoring example</strong><p>This draft demonstrates the site's features. It is not published writing by Jon.</p></aside>}
      <Content />
      {root.data.tags.length > 0 && <ul class="tags" aria-label="Tags">{root.data.tags.map(tag => <li><a href={href(`articles/?tag=${encodeURIComponent(tag)}`)}>{tagLabel(tag)}</a></li>)}</ul>}
      {chapters.length > 1 && <ReadingPagination class="chapter-pagination" label="Page navigation" previous={previous && { href: href(`articles/${previous.id}/`), label: previous.data.navTitle || previous.data.title }} next={next && { href: href(`articles/${next.id}/`), label: next.data.navTitle || next.data.title }} />}
      {related.length > 0 && <section class="related-articles" aria-labelledby="related-articles"><h2 id="related-articles">Related articles</h2><ul class="section-list">{related.map(entry => <li><EntryRow url={href(`articles/${entry.id}/`)} title={entry.data.title} description={entry.data.description} tags={entry.data.tags} date={entry.data.date} updated={entry.data.updated} tagLinks /></li>)}</ul></section>}
    </article>
  </div>
</SiteLayout>
<style>
  .writing-reader { min-width: 0; }
  .has-chapters { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 40px; }
  .has-outline { display: grid; grid-template-columns: minmax(0, 720px) 220px; gap: 48px; justify-content: center; }
  .has-chapters.has-outline { grid-template-columns: 200px minmax(0, 720px) 200px; gap: 32px; }
  .writing-reader :global(.reader-outline) { grid-column: 2; grid-row: 1; }
  .has-chapters :global(.reader-outline) { grid-column: 3; }
  article { grid-column: 1; grid-row: 1; }
  .has-chapters article { grid-column: 2; }
  .prose { width: 100%; min-width: 0; }
  .chapter-sidebar { font-size: .9rem; }
  .chapter-sidebar { position: sticky; top: calc(var(--sl-nav-height) + 32px); align-self: start; }
  .pages-toggle { display: none; min-height: 44px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); background: var(--surface); cursor: pointer; }
  .page-outline { padding-block: 16px; margin-bottom: 32px; font-size: .9rem; }
  .page-outline ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; row-gap: 4px; list-style: none; margin-block: 12px 0; padding: 0; }
  .page-outline li { padding-left: calc(var(--outline-depth) * 16px); }
  .page-outline a { display: inline-flex; align-items: center; min-height: 44px; padding-block: 8px; text-decoration: none; }
  .page-outline a:hover { text-decoration: underline; }
  @media (max-width: 1099px) { .has-outline, .has-chapters.has-outline { display: block; } .chapter-sidebar { margin-bottom: 24px; position: static; } .pages-toggle { display: inline-flex; } #article-pages { margin-top: 12px; } }
  @media (max-width: 799px) { .has-chapters { display: block; } }
  @media (max-width: 479px) { .page-outline ul { grid-template-columns: 1fr; } }
</style>
<script>
 const button = document.querySelector<HTMLButtonElement>('[data-pages-toggle]');
 const nav = document.getElementById('article-pages');
 if (button && nav) {
  const narrow = matchMedia('(max-width: 1099px)');
  const reset = () => { nav.hidden = narrow.matches; button.setAttribute('aria-expanded', String(!nav.hidden)); };
  reset(); narrow.addEventListener('change', reset);
  button.addEventListener('click', () => { nav.hidden = !nav.hidden; button.setAttribute('aria-expanded', String(!nav.hidden)); });
 }
</script>
