---
import WritingFilters from '../../components/WritingFilters.astro';
import EntryRow from '../../components/EntryRow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { normalizeTags } from '../../lib/tags';
import { posts, href } from '../../lib/site';
const entries = await posts();
const tags = normalizeTags([...new Set(entries.flatMap(p => p.data.tags))].sort());
---
<SiteLayout title="Articles">
  <h1>Articles</h1>
  <WritingFilters tags={tags} />
  {entries.length > 0 && <ul class="section-list writing-list">{entries.map(post => <li data-tags={JSON.stringify(post.data.tags)}><EntryRow url={href(`articles/${post.id}/`)} title={post.data.title} tags={post.data.tags} date={post.data.date} updated={post.data.updated} tagLinks description={post.data.description} draft={post.data.draft} /></li>)}</ul>}
  <p class="empty" data-empty hidden={entries.length > 0}>No articles to show.</p>
</SiteLayout>